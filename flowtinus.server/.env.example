# Copy to flowtinus.server/.env (Bun loads .env from the folder it runs in). flowtinus.server/.env is not committed.
# The database: the Postgres of docker-compose.yml (`docker compose up -d` at the root; user, password and port in the
# root .env, see the root .env.example). Required: without it the server does not start.
DATABASE_URL=postgres://flowtinus:flowtinus@localhost:5432/flowtinus
ENVIRONMENT=DEV
API_PORT=5190
# workers the supervisor starts = runs executed at the same time on this machine (one worker = one run)
WORKERS=1
# SUPERVISOR_NAME: how the Workers page names it (default: its container's name in Docker, else the host name)
# the tags whose runs it takes (a flow's tag, set in the editor), comma separated: e.g. default,heavy
WORKER_TAGS=default
# the api's and the supervisor's own log: LOG_LEVEL debug, info (default), warn or error (debug adds every read of the
# api and when each run is claimed); LOG_FORMAT pretty (default, for a terminal) or json (one event per line, for a collector)
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# the editor's address, for the links the MCP (/mcp) gives an agent (DEV default: http://localhost:5180)
# EDITOR_URL=https://flowtinus.example.com
# keys that encrypt the secrets (AES-256-GCM); the last one encrypts, all decrypt (rotation). Required outside DEV;
# in DEV, without it, a fixed dev key is used (never for real data). New key: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
# SECRETS_KEYS=v1:<base64 of 32 bytes>
# DEV only: the dev user's personal access token for the MCP (/mcp), seeded at start (default in seed-dev.ts: DEV_PAT)
# SEED_DEV_PAT=ftn_dev_something_of_your_own
