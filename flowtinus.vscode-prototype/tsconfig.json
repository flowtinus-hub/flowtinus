{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM"],
    "types": ["bun", "vscode"]
  },
  "include": ["src", "scripts"],
  "exclude": ["src/webview-editor"]
}
