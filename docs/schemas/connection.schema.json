{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/flowtinus-hub/flowtinus/main/docs/schemas/connection.schema.json",
  "title": "Flowtinus connection",
  "description": "A connection declared; its name is the file name. Its configuration and credentials stay on each server.",
  "type": "object",
  "required": ["id", "type"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "the identity: stays the same across renames and moves" },
    "type": {
      "enum": [
        "rest-basic",
        "rest-oauth2",
        "http-client",
        "soap",
        "s3",
        "azure-blob",
        "gcs",
        "sftp",
        "postgresql",
        "sqlserver",
        "mysql",
        "mongodb",
        "redshift",
        "kafka",
        "rabbitmq",
        "azure-service-bus",
        "sqs"
      ]
    }
  }
}
