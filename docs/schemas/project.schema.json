{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/flowtinus-hub/flowtinus/main/docs/schemas/project.schema.json",
  "title": "Flowtinus project",
  "description": "A project; its name is its folder's.",
  "type": "object",
  "required": ["id"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "the identity, a UUID in lower case: stays the same across renames and moves"
    },
    "description": { "type": "string" },
    "icon": { "type": "string" },
    "color": { "type": "string" }
  }
}
