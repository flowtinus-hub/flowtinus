# Copy to .env at the root (not committed): the settings of docker-compose.yml. Dev values only.

# Postgres (the host port: change it when 5432 is taken by another Postgres)
POSTGRES_USER=flowtinus
POSTGRES_PASSWORD=flowtinus
POSTGRES_DB=flowtinus
POSTGRES_PORT=5432

# the server in Docker (`docker compose --profile server up -d`); `npm run start` reads flowtinus.server/.env instead
ENVIRONMENT=DEV
# workers the supervisor starts = runs executed at the same time (one worker = one run)
WORKERS=1
# the tags whose runs it takes (a flow's tag, set in the editor), comma separated: e.g. default,heavy
WORKER_TAGS=default
# the color of its tags on the screens: a name (red, orange, amber, green, teal, sky, blue, violet, pink...) or #rrggbb
# WORKER_COLOR=violet
# how many runs one Flow Invoker may fire and forget in a run, per worker (default 4)
# FIRE_AND_FORGET_PER_WORKER=4
# the server's own log in Docker (JSON there): debug adds every read of the api and when each run is claimed
LOG_LEVEL=info
# keys that encrypt the secrets: empty in DEV (a fixed dev key, never for real data); required outside DEV
# SECRETS_KEYS=v1:<base64 of 32 bytes>

# OpenObserve (`docker compose --profile observability up -d`): the login of http://localhost:5080, and its host port
# (the password needs 8+ characters with upper, lower, digit and special, or openobserve refuses to start)
OPENOBSERVE_USER=root@flowtinus.local
OPENOBSERVE_PASSWORD=Flowtinus#2027
OPENOBSERVE_PORT=5080
